# Copy to backend/.env (fstack does this for you). Shell variables win.
# URL-encode special characters in username/password.
APP_ENVIRONMENT=development
# Local MySQL as root; `make seed` creates the database. `fstack new` puts in
# $DB_ROOT_PASSWORD (else root).
APP_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/fstack_starter
APP_ALLOWED_ORIGINS=http://127.0.0.1:5710,http://localhost:5710
APP_COOKIE_SECURE=false

# Access key: signs in to the dashboard and authorises API calls
# (`Authorization: Bearer <key>`). 32+ random characters; `make key` prints one.
# Changing it signs every browser out. Production refuses to start without it.
APP_ACCESS_KEY=

# Provider-key encryption (AES-256-GCM). 32-byte key, urlsafe base64 or hex.
# Production refuses to start without it.
APP_ENCRYPTION_KEY=

# Optional env-only provider so `make seed` can add one without the UI.
# kind: openai | anthropic | bedrock | google   (openai covers any OpenAI-compatible URL;
# Workers AI: https://api.cloudflare.com/client/v4/accounts/<account id>/ai/v1 + API token)
# APP_BOOTSTRAP_PROVIDER_KIND=openai
# APP_BOOTSTRAP_PROVIDER_BASE_URL=
# APP_BOOTSTRAP_PROVIDER_API_KEY=
# APP_BOOTSTRAP_MODEL=gpt-5.4-mini

# Observability: keep rendered prompts + outputs on fstack_llm_calls (off by default).
APP_LOG_LLM_PAYLOADS=false
# Prices: https://models.dev/api.json, refreshed by `make prices`.
APP_MODELS_DEV_URL=https://models.dev/api.json
APP_WORKER_CONCURRENCY=2
